    <!-- Privacy -->
    <string name="photos_privacy_title">Private by design</string>
    <string name="photos_privacy_text">Photos are copied into the app\'s private storage: they don\'t show up in your gallery, never leave this phone and are not included in the JSON backup. Uninstalling the app erases them; your originals stay untouched in your gallery.</string>
