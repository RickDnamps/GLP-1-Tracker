    <!-- Progress photos (ui/screens/PhotosScreen.kt) -->
    <string name="photos_title">Progress photos</string>
    <string name="photos_entry_empty">The scale lies, photos don\'t. Start your before / after.</string>
    <plurals name="photos_entry_count">
