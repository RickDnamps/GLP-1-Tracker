    <!-- Empty state -->
    <string name="photos_hero_badge">Before / after</string>
    <string name="photos_hero_title">The scale lies, photos don\'t</string>
    <string name="photos_hero_text">Water, salt, hormones and new muscle make the scale bounce from one day to the next. A photo every few weeks shows what the number hides: your waist, your face, the way your clothes fit.</string>
    <string name="photos_hero_tip_1">Same spot, same light, same clothes, ideally in the morning.</string>
    <string name="photos_hero_tip_2">Front, side and back, every 2 to 4 weeks.</string>
    <string name="photos_hero_tip_3">Then slide between your first and latest photo.</string>

