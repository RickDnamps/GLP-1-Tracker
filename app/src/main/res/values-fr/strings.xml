    <string name="insights_appetite_title">Appétit au fil de la semaine</string>
    <string name="insights_need_more_appetite">Notez votre appétit dans le journal quelques jours différents pour voir quand il revient.</string>
    <string name="insights_appetite_back">Votre appétit revient en général vers le jour %1$d après l\'injection : prévoyez des repas et collations riches en protéines ces jours-là.</string>
    <string name="insights_appetite_steady">Votre appétit reste bas toute la semaine — bien, mais gardez assez de protéines.</string>
    <string name="insights_trend_title">Poids tendance et plateaux</string>
    <string name="insights_plateau">Vrai plateau : votre poids tendance est stable depuis environ %1$d jours.</string>
    <string name="insights_plateau_tips">Les plateaux sont normaux. Vérifiez protéines, sommeil, eau et activité ; parlez à votre médecin avant de changer de dose.</string>
    <string name="insights_losing">Votre tendance baisse d\'environ %1$s par semaine.</string>
    <string name="insights_gaining">Votre tendance remonte ces derniers temps. L\'eau, le sel ou les hormones expliquent souvent les petites hausses.</string>
    <string name="insights_need_more_weights">Pesez-vous au moins 4 fois sur 2 semaines pour débloquer cette analyse.</string>
    <string name="insights_trend_explain">La courbe tendance lisse les variations d\'eau quotidiennes pour montrer la vraie direction.</string>
    <string name="insights_pace_title">Rythme de perte</string>
    <string name="insights_pace_slow">%1$s %% du poids par semaine : lent et régulier.</string>
    <string name="insights_pace_healthy">%1$s %% du poids par semaine : un rythme sain 👍</string>
    <string name="insights_pace_fast">%1$s %% par semaine : rapide. Priorisez protéines et musculation pour protéger vos muscles.</string>
    <string name="insights_pace_very_fast">%1$s %% par semaine : très rapide. Risque accru de perte musculaire, de chute de cheveux et de calculs biliaires — parlez-en à votre médecin.</string>
    <string name="insights_protein_title">Coach protéines</string>
    <string name="insights_protein_range">Suggéré : %1$d à %2$d g de protéines par jour</string>
    <string name="insights_protein_avg">Votre moyenne sur 7 jours : %1$d g/jour</string>
    <string name="insights_protein_tip">1,2 à 1,6 g par kg de poids visé aide à garder les muscles en perdant du gras. Yogourt grec, œufs, cottage, poisson, tofu, boissons protéinées.</string>
    <string name="insights_protein_set">Mettre mon objectif à %1$d g</string>
    <string name="insights_disclaimer">Ce sont des statistiques tirées de vos données, pas un diagnostic. Discutez de tout changement de traitement avec votre professionnel de la santé.</string>
    <string name="tools_title">Outils</string>
    <string name="syringe_title">Calculateur de seringue (U-100)</string>
    <string name="syringe_help">Pour les fioles (ex. magistrales) : entrez la concentration inscrite sur l\'étiquette et votre dose. 1 mL = 100 unités sur une seringue à insuline U-100.</string>
    <string name="syringe_concentration">Concentration</string>
    <string name="syringe_result">%1$s mL = %2$s unités</string>
    <string name="syringe_warn_small">Moins de 2 unités : trop petit pour être mesuré avec précision.</string>
    <string name="syringe_warn_over">Plus d\'une seringue pleine : vérifiez la concentration et la dose.</string>
    <string name="syringe_warn_tenfold">Très différent de votre dernière dose : vérifiez une erreur de virgule (0,5 vs 5).</string>
    <string name="syringe_disclaimer">Confirmez toujours le volume avec votre pharmacien. Des surdoses ont été rapportées à cause de confusions unités/mL.</string>
    <string name="rf_title">Quand demander de l\'aide</string>
    <string name="rf_intro">Touchez un symptôme pour les détails. Dans le doute, appelez le 811 (Info-Santé) ou le 911 en cas d\'urgence.</string>
    <string name="rf_pancreatitis">Douleur au ventre intense et persistante</string>
    <string name="rf_pancreatitis_detail">Une forte douleur dans le haut du ventre, parfois vers le dos, avec ou sans vomissements, peut être un signe de pancréatite. Consultez d\'urgence.</string>
    <string name="rf_gallbladder">Douleur sous les côtes à droite, fièvre, peau ou yeux jaunes</string>
    <string name="rf_gallbladder_detail">Ce peuvent être des signes de problèmes de vésicule biliaire (calculs), plus fréquents avec une perte de poids rapide. Consultez rapidement.</string>
    <string name="rf_dehydration">Vomissements ou diarrhée qui ne s\'arrêtent pas</string>
    <string name="rf_dehydration_detail">Perdre des liquides peut vous déshydrater et fatiguer les reins. Buvez par petites gorgées souvent ; appelez le 811 ou votre médecin si vous ne gardez rien, urinez peu ou êtes étourdi.</string>
    <string name="rf_allergy">Gonflement du visage, des lèvres ou de la gorge, difficulté à respirer</string>
    <string name="rf_allergy_detail">Possible réaction allergique grave. Appelez le 911 immédiatement.</string>
    <string name="rf_hypoglycemia">Tremblements, sueurs, confusion (diabète)</string>
    <string name="rf_hypoglycemia_detail">Avec l\'insuline ou les sulfonylurées, les GLP-1 peuvent causer une hypoglycémie. Prenez du sucre rapide (jus, comprimés de glucose) et mesurez votre glycémie ; informez votre médecin.</string>
    <string name="rf_vision">Changements soudains de la vision (diabète)</string>
    <string name="rf_vision_detail">Les personnes atteintes de rétinopathie diabétique doivent signaler rapidement tout changement de vision à leur médecin.</string>
    <string name="rf_thyroid">Bosse dans le cou, voix rauque, difficulté à avaler</string>
    <string name="rf_thyroid_detail">Rare, mais mentionné dans les mises en garde de ces médicaments. Montrez-le à votre médecin.</string>
    <string name="rf_mood">Humeur sombre, idées noires</string>
    <string name="rf_mood_detail">Vous n\'êtes pas seul. Appelez ou textez le 988 (ligne de crise suicide, 24/7) ou le 911 si vous êtes en danger.</string>
