    <string name="photos_hero_title">La balance ment, les photos, non</string>
    <string name="photos_hero_text">L\'eau, le sel, les hormones et les nouveaux muscles font varier la balance d\'un jour à l\'autre. Une photo toutes les quelques semaines montre ce que le chiffre cache : votre taille, votre visage, la façon dont vos vêtements tombent.</string>
    <string name="photos_hero_tip_1">Même endroit, même lumière, mêmes vêtements, idéalement le matin.</string>
    <string name="photos_hero_tip_2">De face, de profil et de dos, toutes les 2 à 4 semaines.</string>
    <string name="photos_hero_tip_3">Puis faites glisser entre votre première et votre dernière photo.</string>

